set hidden true
# set drawbox true
set icons true
set preview true
set info size
set mouse true
set number true
set relativenumber true
set cursorpreviewfmt "\033[7;35m"
# not working - map <cr> open

# file editor
# map e shell-wait nvim "$f"
# map E shell-wait emacsclient -s straight -t -- $fx
map e $nvim "$f"
map E $emacsclient -s straight -t -- "$fx"

# preview
set preview true

set previewer ~/.config/lf/previewer
set cleaner ~/.config/lf/cleaner

# Better scrolling
map J page-down
map K page-up

# Open shell
map <c-s> shell-wait
# map <c-s> push $

# Reload config
map R reload

# mkdir
map a push %mkdir<space>

# rename
map r push %rename<space>

# delete
map d delete

# copy/move
map c copy
map m mv

# bookmark
# for temporary bookmark use m then assign a alphabate
# visit the bookmark by '+alphabate assign
map gh cd ~
map gr cd /
map gd cd ~/mine_quarantine/
map gn cd ~/Mine/Notes/

# extract archives
cmd extract ${{
    case "$f" in
        *.tar.bz2) tar xjf "$f" ;;
        *.tar.gz)  tar xzf "$f" ;;
        *.bz2)     bunzip2 "$f" ;;
        *.rar)     unrar x "$f" ;;
        *.gz)      gunzip "$f" ;;
        *.tar)     tar xf "$f" ;;
        *.tbz2)    tar xjf "$f" ;;
        *.tgz)     tar xzf "$f" ;;
        *.zip)     unzip "$f" ;;
        *.7z)      7z x "$f" ;;
        *) echo "unknown archive" ;;
    esac
}}

# open files
cmd open ${{
    case "$(file --mime-type -Lb "$f")" in

        text/*)
            ${EDITOR:-nvim} "$f"
            ;;

        image/*)
            kitten icat "$f"
            ;;

        video/*)
            mpv "$f"
            ;;

        audio/*)
            mpv "$f"
            ;;

        application/pdf)
            zathura "$f"
            ;;

        *)
            xdg-open "$f" >/dev/null 2>&1 &
            ;;
    esac
}}